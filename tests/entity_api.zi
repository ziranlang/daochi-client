// C test exports only; apps import entity directly.
#import "entity"

#program_export
EntityTestRecordKey :: (private_key: []u8, kind: string, output: []u8) -> bool {
    return EntityRecordKey(private_key, kind, output)
}

#program_export
EntityTestBlobKey :: (private_key: []u8, kind: string, hash: string, output: []u8) -> bool {
    return EntityBlobKey(private_key, kind, hash, output)
}

#program_export
EntityTestChunkKey :: (private_key: []u8, kind: string, hash: string, index: s64, output: []u8) -> bool {
    return EntityChunkKey(private_key, kind, hash, index, output)
}

#program_export
EntityTestSeal :: (private_key: []u8, kind: string, hash: string, index: s64, plain: []u8, output: []u8) -> s64 {
    return SealEntityChunk(private_key, kind, hash, index, plain, output)
}

#program_export
EntityTestOpen :: (private_key: []u8, kind: string, hash: string, index: s64, sealed: []u8, output: []u8) -> s64 {
    return OpenEntityChunk(private_key, kind, hash, index, sealed, output)
}

#import "crypto"

#program_export
EntityTestSha256Hex :: (data: []u8, output: []u8) {
    if data.count > 0 && output.count >= 65 { Sha256Hex(*data[0], data.count, *output[0]) }
}
