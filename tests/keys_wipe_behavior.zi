// Secrets the key code decodes or derives are wiped before it returns.
// tests/run.sh wraps Oqs's Cleanse, which SecureWipe calls in another file,
// so each wipe is observed after it happens.
#import "oqs/Oqs"
#import "byte_text_linux"
#import "keys"

private_wipes: s32;
signature_wipes: s32;
key_wipes: s32;
plaintext_wipes: s32;
sealed_wipes: s32;
cleanup_failed: bool;

#program_export
ObservedWipe :: (output: *u8, length: s64) {
    if output == null || length <= 0 {
        return
    }
    if length == 2560 {
        private_wipes += 1
    }
    if length == 2420 {
        signature_wipes += 1
    }
    if length == 32 {
        key_wipes += 1
    }
    if length == ACCOUNT_EXPORT_TEXT_SIZE {
        plaintext_wipes += 1
    }
    if length == ACCOUNT_EXPORT_TEXT_SIZE + AccountEncryptedTagBytes {
        sealed_wipes += 1
    }
    // Called after the real wipe (see the test's __wrap_Cleanse).
    index: s64 = 0
    while index < length {
        if output[index] != cast(u8)0 {
            cleanup_failed = true
        }
        index += 1
    }
}

ResetCounts :: () {
    private_wipes = 0
    signature_wipes = 0
    key_wipes = 0
    plaintext_wipes = 0
    sealed_wipes = 0
}

#program_export
Check :: () -> s32 {
    ObservedWipe(null, 0)
    account: AccountKeys
    signature: [ACCOUNT_SIGNATURE_HEX_SIZE]u8
    encrypted: [ACCOUNT_EXPORT_ENCRYPTED_TEXT_SIZE]u8
    loaded: AccountKeys
    if CreateAccountKeys(*account) == 0 {
        return 1
    }
    ResetCounts()
    if !SignAccountMessage(cast(*void)*account, "cleanup regression", signature[:]) ||
        private_wipes < 1 || signature_wipes < 1 || cleanup_failed {
        return 2
    }
    ResetCounts()
    if SignAccountKeysHex(*account, null, 0, *signature[0], 1) != 0 ||
        private_wipes != 1 || signature_wipes != 1 || cleanup_failed {
        return 3
    }
    account.private_key_hex[0] = cast(u8)120
    ResetCounts()
    if SignAccountMessage(cast(*void)*account, "cleanup regression", signature[:]) ||
        private_wipes != 1 || signature_wipes != 1 || cleanup_failed {
        return 4
    }
    if CreateAccountKeys(*account) == 0 {
        return 5
    }
    ResetCounts()
    if AccountKeysEncryptedText(*account, "synthetic cleanup passphrase", *encrypted[0], encrypted.count) == 0 ||
        key_wipes < 1 || plaintext_wipes < 1 || sealed_wipes < 1 || cleanup_failed {
        return 6
    }
    ResetCounts()
    if ParseEncryptedAccountKeys(AccountBufferText(*encrypted[0], cast(s64)encrypted.count),
        "synthetic cleanup passphrase", *loaded) == 0 ||
        key_wipes < 1 || plaintext_wipes < 2 || cleanup_failed {
        return 7
    }
    ResetCounts()
    if ParseEncryptedAccountKeys(AccountBufferText(*encrypted[0], cast(s64)encrypted.count),
        "wrong synthetic passphrase", *loaded) != 0 ||
        key_wipes < 1 || plaintext_wipes < 2 || loaded.private_key_hex[0] != cast(u8)0 || cleanup_failed {
        return 8
    }
    ResetCounts()
    if AccountKeysEncryptedText(*account, "synthetic cleanup passphrase", *encrypted[0], 1) != 0 ||
        key_wipes < 1 || plaintext_wipes < 1 || sealed_wipes < 1 || cleanup_failed {
        return 9
    }
    Cleanse(account.private_key_hex[:])
    Cleanse(loaded.private_key_hex[:])
    return 0
}
