// Protocol v6 sync orchestration. The host provisions and stores device keys;
// this module signs the Daochi wire messages and sends them through Client.
#import "client"
#import "auth"
#import "transaction"
#import "wire"
#import "net_http"
#import "text_buffer"

RandomNonce :: #type (context: *void, output: []u8) -> bool #c_call;

Device :: struct {
    key_id: string
    public_key_hex: string
    signing_context: *void
    signer: SignMessage
}

SignatureHex :: (value: string, length: s64) -> bool {
    if cast(s64)value.count != length {
        return false
    }
    index: s64 = 0
    while index < length {
        byte := value[index]
        if !((byte >= cast(u8)48 && byte <= cast(u8)57) ||
            (byte >= cast(u8)65 && byte <= cast(u8)70) ||
            (byte >= cast(u8)97 && byte <= cast(u8)102)) {
            return false
        }
        index += 1
    }
    return true
}

ServerNow :: (session: *Session, now: s64) -> s64 {
    if session.server_time <= 0 || session.login_local_time <= 0 ||
        now < session.login_local_time ||
        now - session.login_local_time > 86400 {
        return now
    }
    return session.server_time + now - session.login_local_time
}

CreateNonce :: (random_context: *void, random: RandomNonce,
    output: []u8) -> bool {
    if output.count < 65 {
        return false
    }
    output[0] = cast(u8)0
    return random(random_context, output) &&
        Hex64(TextUntilNul(output[:]))
}

#scope_export
#program_export
RegisterDevice :: (client: Client, session: *Session,
    device: Device, now: s64, random_context: *void,
    random: RandomNonce) -> AuthResult {
    ready := EnsureSession(client, session, now)
    if ready != cast(AuthResult)AuthResult.AUTH_OK {
        return ready
    }
    body: [6144]u8
    prepared := PrepareDeviceRegistration(client, session, device, now,
        random_context, random, body[:])
    if prepared != cast(AuthResult)AuthResult.AUTH_OK {
        return prepared
    }
    response: [2048]u8
    status: s32 = 0
    return BearerRequest(client, session, now, "POST",
        "/api/v1/account/devices", TextUntilNul(body[:]),
        response[:], *status)
}

#scope_export
#program_export
Sync :: (client: Client, session: *Session, device: Device,
    now: s64, random_context: *void, random: RandomNonce,
    body: string, output: []u8, status: *s32) -> AuthResult {
    if output.count == 0 || status == null || body.count == 0 {
        return cast(AuthResult)AuthResult.AUTH_PAYLOAD_FAILED
    }
    output[0] = cast(u8)0
    status.* = 0
    registered := RegisterDevice(client, session, device, now,
        random_context, random)
    if registered != cast(AuthResult)AuthResult.AUTH_OK {
        return registered
    }
    transaction_header: [8192]u8
    prepared := PrepareSyncHeader(client, session, device, now,
        random_context, random, body, transaction_header[:])
    if prepared != cast(AuthResult)AuthResult.AUTH_OK {
        return prepared
    }
    extra: [1]HttpHeader
    extra[0].name = "X-Daochi-Tx"
    extra[0].value = TextUntilNul(transaction_header[:])
    return BearerRequestWithHeaders(client, session, now,
        "POST", "/api/v1/sync", body, output, status, extra[:])
}

// Shared request preparation for blocking and frame-driven transports.
#scope_export
PrepareDeviceRegistration :: (client: Client, session: *Session,
    device: Device, now: s64, random_context: *void,
    random: RandomNonce, body: []u8) -> AuthResult {
    if !Hex64(device.key_id) ||
        !Hex64(device.public_key_hex) {
        return cast(AuthResult)AuthResult.AUTH_PAYLOAD_FAILED
    }
    nonce: [65]u8
    if !CreateNonce(random_context, random, nonce[:]) {
        return cast(AuthResult)AuthResult.AUTH_SIGN_FAILED
    }
    server_now := ServerNow(session, now)
    if server_now <= 0 || server_now > 9007199254740691 {
        return cast(AuthResult)AuthResult.AUTH_SIGN_FAILED
    }
    registration: DeviceRegistration
    registration.account_id = client.identity.account_id
    registration.app_id = client.app_id
    registration.device_key_id = device.key_id
    registration.client_id = client.identity.client_id
    registration.public_key_hex = device.public_key_hex
    registration.nonce = TextUntilNul(nonce[:])
    registration.expires_at = server_now + 300
    message: [1024]u8
    if !BuildDeviceRegistrationMessage(registration, message[:]) {
        return cast(AuthResult)AuthResult.AUTH_PAYLOAD_FAILED
    }
    account_signature: [4841]u8
    if !client.signer(client.identity.signing_context,
        TextUntilNul(message[:]), account_signature[:]) ||
        !SignatureHex(TextUntilNul(account_signature[:]), 4840) {
        return cast(AuthResult)AuthResult.AUTH_SIGN_FAILED
    }
    if !BuildDeviceRegistrationBody(registration,
        TextUntilNul(account_signature[:]), body) {
        return cast(AuthResult)AuthResult.AUTH_PAYLOAD_FAILED
    }
    return cast(AuthResult)AuthResult.AUTH_OK
}

#scope_export
PrepareSyncHeader :: (client: Client, session: *Session, device: Device,
    now: s64, random_context: *void, random: RandomNonce,
    body: string, transaction_header: []u8) -> AuthResult {
    return PrepareRequestHeader(client, session, device, now,
        random_context, random, "POST", "/api/v1/sync", body,
        transaction_header)
}

// Binary bodies and empty GET/HEAD bodies retain their exact byte length.
// Both platform hosts and sync orchestration use the same signed preparation.
#scope_export
PrepareRequestHeader :: (client: Client, session: *Session, device: Device,
    now: s64, random_context: *void, random: RandomNonce,
    method: string, path: string, body: string,
    transaction_header: []u8) -> AuthResult {
    if transaction_header.count == 0 {
        return cast(AuthResult)AuthResult.AUTH_PAYLOAD_FAILED
    }
    transaction_header[0] = cast(u8)0
    if session == null || random == null || client.digest == null {
        return cast(AuthResult)AuthResult.AUTH_PAYLOAD_FAILED
    }
    tx_id: [65]u8
    nonce: [65]u8
    body_hash: [65]u8
    if !CreateNonce(random_context, random, tx_id[:]) ||
        !CreateNonce(random_context, random, nonce[:]) ||
        !client.digest(body, body_hash[:]) ||
        !Hex64(TextUntilNul(body_hash[:])) {
        return cast(AuthResult)AuthResult.AUTH_SIGN_FAILED
    }
    server_now := ServerNow(session, now)
    if server_now <= 0 || server_now > 9007199254740691 {
        return cast(AuthResult)AuthResult.AUTH_SIGN_FAILED
    }
    transaction: SyncTransaction
    transaction.account_id = client.identity.account_id
    transaction.app_id = client.app_id
    transaction.device_key_id = device.key_id
    transaction.tx_id = TextUntilNul(tx_id[:])
    transaction.nonce = TextUntilNul(nonce[:])
    transaction.body_sha256_hex = TextUntilNul(body_hash[:])
    transaction.expires_at = server_now + 300
    return SignTransactionHeader(client, device, transaction, method, path,
        transaction_header)
}

// Hosts that stream and hash a body themselves supply the finished digest and
// expiration. The client owns the account/device signatures and wire format.
#scope_export
SignTransactionHeader :: (client: Client, device: Device,
    transaction: SyncTransaction, method: string, path: string,
    transaction_header: []u8) -> AuthResult {
    if transaction_header.count == 0 {
        return cast(AuthResult)AuthResult.AUTH_PAYLOAD_FAILED
    }
    transaction_header[0] = cast(u8)0
    if client.signer == null || device.signer == null ||
        transaction.account_id != client.identity.account_id ||
        transaction.app_id != client.app_id ||
        transaction.device_key_id != device.key_id {
        return cast(AuthResult)AuthResult.AUTH_PAYLOAD_FAILED
    }
    message: [4096]u8
    if !BuildTransactionMessage(transaction, method, path, message[:]) {
        return cast(AuthResult)AuthResult.AUTH_PAYLOAD_FAILED
    }
    account_signature: [4841]u8
    device_signature: [129]u8
    if !client.signer(client.identity.signing_context,
        TextUntilNul(message[:]), account_signature[:]) ||
        !SignatureHex(TextUntilNul(account_signature[:]), 4840) ||
        !device.signer(device.signing_context,
            TextUntilNul(message[:]), device_signature[:]) ||
        !SignatureHex(TextUntilNul(device_signature[:]), 128) {
        return cast(AuthResult)AuthResult.AUTH_SIGN_FAILED
    }
    if !BuildTransactionHeader(transaction, method, path,
        TextUntilNul(account_signature[:]),
        TextUntilNul(device_signature[:]),
        transaction_header) {
        return cast(AuthResult)AuthResult.AUTH_PAYLOAD_FAILED
    }
    return cast(AuthResult)AuthResult.AUTH_OK
}
